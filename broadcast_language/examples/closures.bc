// Each counter keeps its own private `count` because functions capture the scope they were made in.
protocol makeCounter() {
  assign count = 0;
  protocol next() {
    count = count + 1;
    report count;
  }
  report next;
}

assign a = makeCounter();
assign b = makeCounter();
broadcast "a() = " + a();
broadcast "a() = " + a();
broadcast "b() = " + b();   // b has its own count, so it starts again at 1
broadcast "a() = " + a();
