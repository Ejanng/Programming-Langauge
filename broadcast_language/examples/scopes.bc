// Block scopes, shadowing, and closures that capture variables from several levels up.
assign x = "global";
{
  assign x = "outer block";
  {
    assign x = "inner block";
    broadcast x;
  }
  broadcast x;
}
broadcast x;

// Two closures made in the same call share one captured variable.
protocol makePair() {
  assign n = 0;
  protocol inc() { n = n + 1; report n; }
  protocol get() { report n; }
  report fn_pair(inc, get);
}
protocol fn_pair(a, b) {
  protocol pick(which) { when (which == "inc") report a; report b; }
  report pick;
}
assign pair = makePair();
pair("inc")();
pair("inc")();
broadcast pair("get")();

// A capture that passes through a middle function it is not used in.
protocol outer() {
  assign secret = "found it";
  protocol middle() {
    protocol inner() { report secret; }
    report inner;
  }
  report middle();
}
broadcast outer()();

// Each loop iteration gets its own variable, so each closure remembers a different value.
assign first = silence;
assign second = silence;
assign i = 0;
repeat (i < 2) {
  assign copy = i * 10;
  protocol show() { report copy; }
  when (i == 0) first = show; otherwise second = show;
  i = i + 1;
}
broadcast first();
broadcast second();

// Recursion through a local function.
protocol countdown(n) {
  protocol go(k) { when (k == 0) report "liftoff"; report go(k - 1); }
  report go(n);
}
broadcast countdown(5);
