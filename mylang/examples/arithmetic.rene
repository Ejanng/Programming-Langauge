// Integer arithmetic: the core requirement of the language.

print "-- basic operators --";
print 7 + 5;          // 12
print 7 - 5;          // 2
print 7 * 5;          // 35
print 20 / 4;         // 5
print 17 % 5;         // 2 (remainder)

print "-- precedence and grouping --";
print 2 + 3 * 4;      // 14: * and / bind tighter than + and -
print (2 + 3) * 4;    // 20: parentheses group first
print 100 - 10 - 1;   // 89: same-precedence operators go left to right
print 2 * (3 + 4) * 5;

print "-- negative numbers --";
print -8 + 3;
print 5 - 12;
print -(4 * 3);
print -17 % 5;        // the remainder takes the sign of the left operand

print "-- large whole numbers stay exact --";
print 2147483647 + 1;
print 1000000 * 1000000;
print 9007199254740992;

print "-- division that does not come out even --";
print 7 / 2;          // 3.5
print 1 / 3;

print "-- variables and expressions --";
let width = 12;
let height = 7;
let area = width * height;
print "area = " + area;
print "perimeter = " + 2 * (width + height);

fn power(base, exp) {
  let result = 1;
  while (exp > 0) {
    result = result * base;
    exp = exp - 1;
  }
  return result;
}
print "2^10 = " + power(2, 10);
print "3^5 = " + power(3, 5);
