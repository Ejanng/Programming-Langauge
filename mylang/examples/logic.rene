// Operators, truthiness and when/otherwise.
broadcast 10 % 3;
broadcast 7 / 2;
broadcast -(2 + 3);
broadcast 1 < 2 and 2 < 3;
broadcast silence or "default";
broadcast !affirm;
broadcast 1 == 1;
broadcast "a" == "a";
broadcast silence == negative;
assign x = 5;
when (x > 3) broadcast "big"; otherwise broadcast "small";
